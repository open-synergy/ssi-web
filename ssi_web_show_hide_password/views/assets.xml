<odoo>
    <!-- web.assets_common is the single registration point on purpose:
         it is pulled by web.frontend_layout (hence by web.login_layout)
         and by web.webclient_bootstrap alike, so one entry covers both
         the public login page and the whole backend. -->
    <template
        id="assets_common"
        name="ssi_web_show_hide_password assets"
        inherit_id="web.assets_common"
    >
        <xpath expr="." position="inside">
            <link
                rel="stylesheet"
                type="text/css"
                href="/ssi_web_show_hide_password/static/src/scss/show_hide_password.scss"
            />
            <script
                type="text/javascript"
                src="/ssi_web_show_hide_password/static/src/js/show_hide_password.js"
            />
        </xpath>
    </template>

    <template
        id="qunit_suite_tests"
        name="ssi_web_show_hide_password tests"
        inherit_id="web.qunit_suite_tests"
    >
        <xpath expr="." position="inside">
            <script
                type="text/javascript"
                src="/ssi_web_show_hide_password/static/tests/show_hide_password_tests.js"
            />
        </xpath>
    </template>
</odoo>
