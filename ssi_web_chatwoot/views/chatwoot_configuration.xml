<odoo>
    <!-- Search View -->
    <record id="chatwoot_configuration_view_search" model="ir.ui.view">
        <field name="name">chatwoot_configuration - search</field>
        <field name="model">chatwoot_configuration</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <!-- Tree View -->
    <record id="chatwoot_configuration_view_tree" model="ir.ui.view">
        <field name="name">chatwoot_configuration - tree</field>
        <field name="model">chatwoot_configuration</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_tree"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="base_url" />
                    <field name="company_id" />
                </xpath>
            </data>
        </field>
    </record>

    <!-- Form View -->
    <record id="chatwoot_configuration_view_form" model="ir.ui.view">
        <field name="name">chatwoot_configuration - form</field>
        <field name="model">chatwoot_configuration</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_form"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//notebook/page[@name='note']" position="before">
                    <page name="connection" string="Connection">
                        <group name="connection_group_1" string="Chatwoot Server">
                            <field name="base_url" />
                            <field name="website_token" />
                        </group>
                        <group name="connection_group_2" string="Identity Validation">
                            <field name="identity_validation_ok" />
                            <field
                                name="hmac_token"
                                attrs="{'invisible': [('identity_validation_ok', '=', False)]}"
                            />
                        </group>
                    </page>
                    <page name="widget" string="Widget">
                        <group name="widget_group_1" string="Appearance">
                            <field name="widget_locale" />
                            <field name="widget_position" />
                            <field name="widget_type" />
                            <field name="launcher_title" />
                        </group>
                        <group name="widget_group_2" string="Visibility">
                            <field name="company_id" />
                            <field name="group_ids" widget="many2many_tags" />
                        </group>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <!-- Action -->
    <record id="chatwoot_configuration_action" model="ir.actions.act_window">
        <field name="name">Chatwoot Configuration</field>
        <field name="res_model">chatwoot_configuration</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="chatwoot_configuration_menu"
        parent="base.menu_custom"
        action="chatwoot_configuration_action"
    />
</odoo>
