<templates xml:space="preserve">

    <t t-name="ssi_web_edit_attachment_name.AttachmentRenameDialog">
        <Dialog title="title" size="'md'">
            <div class="o_attachment_rename_dialog">
                <label
                    for="ssi_attachment_rename_input"
                    class="col-form-label"
                >New name</label>
                <input
                    t-ref="autofocus"
                    id="ssi_attachment_rename_input"
                    type="text"
                    class="o_input form-control mt-1"
                    t-att-value="props.currentName"
                    t-on-keydown="onKeydown"
                />
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="onClickSave">Save</button>
                <button
                    class="btn btn-secondary"
                    t-on-click="onClickCancel"
                >Cancel</button>
            </t>
        </Dialog>
    </t>

</templates>
