<odoo>
    <template
        id="assets_backend"
        name="ssi_web_widget_rjsf backend assets"
        inherit_id="web.assets_backend"
    >
        <xpath expr="." position="inside">
            <!-- Self-contained RJSF bundle (React 17 + @rjsf/core 5 + validator-ajv8) -->
            <script
                type="text/javascript"
                src="/ssi_web_widget_rjsf/static/lib/rjsf-bundle.js"
            />
            <link
                rel="stylesheet"
                href="/ssi_web_widget_rjsf/static/src/css/rjsf_widget.css"
            />
            <script
                type="text/javascript"
                src="/ssi_web_widget_rjsf/static/src/js/rjsf_widget.js"
            />
        </xpath>
    </template>
</odoo>
