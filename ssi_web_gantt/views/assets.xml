                type="text/javascript"
                src="/ssi_web_gantt/static/src/js/gantt_renderer.js"
            />
            <script
                type="text/javascript"
                src="/ssi_web_gantt/static/src/js/gantt_controller.js"
            />
            <script
                type="text/javascript"
                src="/ssi_web_gantt/static/src/js/gantt_view.js"
            />
        </xpath>
    </template>
</odoo>
