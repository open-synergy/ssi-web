<?xml version="1.0" encoding="utf-8" ?>
<templates>
    <t t-name="ssi_web_gantt.GanttView.Buttons">
        <div class="d-flex o_ssi_gantt_buttons" />
    </t>

    <t t-name="ssi_web_gantt.GanttView">
        <div class="o_ssi_gantt_view d-flex flex-column" t-ref="root">
            <Layout
                className="'o_ssi_gantt_layout d-flex flex-column'"
                display="props.display"
            >
                <t t-set-slot="layout-buttons">
                    <t t-call="{{ props.buttonTemplate }}" />
                </t>
                <t t-set-slot="layout-actions">
                    <SearchBar toggler="searchBarToggler" />
                </t>
                <t t-set-slot="control-panel-navigation-additional">
                    <t
                        t-component="searchBarToggler.component"
                        t-props="searchBarToggler.props"
                    />
                </t>
                <t t-set-slot="default">
                    <div
                        t-if="displayNoContent"
                        class="o_ssi_gantt_no_content text-muted p-4"
                    >
                        No data to display.
                    </div>
                    <t
                        t-else=""
                        t-component="props.Renderer"
                        model="model"
                        archInfo="props.archInfo"
                    />
                </t>
            </Layout>
        </div>
    </t>
</templates>
